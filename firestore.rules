rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 20 && name.matches('^[a-zA-Z0-9_]{3,20}$');
    }

    function isValidUsernameLower(name) {
      return name is string && name.size() >= 3 && name.size() <= 20 && name.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidHeroId(heroId) {
      return heroId is string && heroId.size() >= 1 && heroId.size() <= 64 && heroId.matches('^[a-z0-9\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'username',
          'usernameLower',
          'wins',
          'losses',
          'matchesPlayed',
          'favoriteHero',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'wins',
          'losses',
          'matchesPlayed',
          'favoriteHero',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && isValidUsernameLower(data.usernameLower)
        && data.username.lower() == data.usernameLower
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.losses is int && data.losses >= 0 && data.losses <= 1000000
        && data.matchesPlayed is int && data.matchesPlayed == data.wins + data.losses
        && isValidHeroId(data.favoriteHero)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsernameReservation(data, usernameLower) {
      return data.keys().hasAll(['uid', 'username', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.username.lower() == usernameLower
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().wins == 0
        && incoming().losses == 0
        && incoming().matchesPlayed == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().usernameLower));

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().usernameLower == existing().usernameLower
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'wins',
          'losses',
          'matchesPlayed',
          'favoriteHero',
          'updatedAt'
        ])
        && incoming().wins >= existing().wins
        && incoming().wins <= existing().wins + 1
        && incoming().losses >= existing().losses
        && incoming().losses <= existing().losses + 1
        && incoming().matchesPlayed >= existing().matchesPlayed
        && incoming().matchesPlayed <= existing().matchesPlayed + 1;

      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if isValidUsernameLower(usernameLower) && isSignedIn();
      allow list: if false;

      allow create: if isValidUsernameLower(usernameLower)
        && isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(usernameLower))
        && isValidUsernameReservation(incoming(), usernameLower)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if false;
      allow delete: if isValidUsernameLower(usernameLower)
        && isSignedIn()
        && existing().uid == request.auth.uid;
    }
  }
}
